# Port and interface the web server listens on
PORT=3000
HOST=0.0.0.0

# Where the SQLite database and secret key are stored
DATA_DIR=./data

# Serve the app under a sub-path, e.g. https://example.com/downloader
# Leave empty to serve from the root.
BASE_PATH=

# Optional: 32+ byte secret used to encrypt provider credentials and sign sessions.
# If unset, one is generated on first start and saved to $DATA_DIR/secret.key
# SECRET_KEY=

# Allow HTTPS providers with self-signed certificates
ALLOW_SELF_SIGNED_CERTS=false

# How often (ms) to poll each provider for status
POLL_INTERVAL_MS=2000

# debug | info | warn | error
LOG_LEVEL=info
