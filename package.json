{
  "name": "deliverator",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "A simple, unified web UI for your download clients (qBittorrent, SABnzbd).",
  "license": "MIT",
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "yarn workspaces foreach -A --parallel --interlaced run dev",
    "build": "yarn workspaces foreach -A --topological run build",
    "start": "node packages/server/dist/index.js",
    "test": "yarn workspaces foreach -A run test",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "lint": "yarn workspaces foreach -A run lint",
    "mock": "yarn workspace @deliverator/server mock",
    "cli": "yarn workspace @deliverator/server cli",
    "db:generate": "yarn workspace @deliverator/server db:generate"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependenciesMeta": {
    "better-sqlite3": {
      "built": false
    }
  }
}
