{
  "name": "deliverator",
  "version": "0.1.1",
  "private": true,
  "description": "A simple, unified web UI for your download clients (qBittorrent, SABnzbd).",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @deliverator/server --filter @deliverator/client dev",
    "build": "pnpm -r build",
    "start": "node packages/server/dist/index.js",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @deliverator/server db:generate"
  }
}
